# `//:8545` means "port 8545 on the host this page came from" (see
# web/src/lib/core/env/same-host.ts), so the dev stack works when the page is
# opened from another machine, a phone on the LAN or a remote dev box, and not
# only on the machine running the node. Opened at http://127.0.0.1:5173 it
# resolves to http://127.0.0.1:8545, which is what this line said before.
PUBLIC_NODE_URL="//:8545"
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED="true"
# Deliberately NOT setting PUBLIC_USE_BURNER_WALLET here, even though the
# jolly-roger template's .env.localhost sets it (`=$PUBLIC_NODE_URL`). The
# burner wallet announces itself as a second EIP-6963 provider, so the wallet
# picker offers it alongside the e2e-injected E2EWallet (fixtures/wallet.ts),
# and the connect flow stalls on "Loading Connect" — the mint never reaches
# eth_sendTransaction and mint.spec.ts times out. Mandalas's e2e is built
# around one injected wallet and does not use a burner wallet, so drop this
# line again whenever a template rebase re-introduces it.
#
# The template now pairs it with PUBLIC_IMPERSONATE_ADDRESSES, which is dropped
# here for the same reason: it only names who the burner may impersonate, and
# with no burner there is nobody to be. `web/.env` declares it empty, so the
# `$env/static/public` import still resolves.
# `//:34010` is the same-host notation, taken because this value was identical
# to the template's and is resolved in the browser (core/ui/faucet/index.ts).
PUBLIC_FAUCET_LINK="//:34010"
# The local chain is unknown to every wallet, so it has to be addable. 127.0.0.1
# rather than localhost: wallets are stricter about the loopback literal.
PUBLIC_CHAIN_INFO_NODE_URL="//:8545"
