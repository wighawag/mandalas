PUBLIC_NODE_URL="http://127.0.0.1:8545"
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED="true"
# Deliberately NOT setting PUBLIC_USE_BURNER_WALLET here, even though the
# jolly-roger template's .env.localhost sets it (`=$PUBLIC_NODE_URL`). The
# burner wallet announces itself as a second EIP-6963 provider, so the wallet
# picker offers it alongside the e2e-injected E2EWallet (fixtures/wallet.ts),
# and the connect flow stalls on "Loading Connect" — the mint never reaches
# eth_sendTransaction and mint.spec.ts times out. Mandalas's e2e is built
# around one injected wallet and does not use a burner wallet, so drop this
# line again whenever a template rebase re-introduces it.
PUBLIC_FAUCET_LINK="http://localhost:34010"
# The local chain is unknown to every wallet, so it has to be addable. 127.0.0.1
# rather than localhost: wallets are stricter about the loopback literal.
PUBLIC_CHAIN_INFO_NODE_URL="http://127.0.0.1:8545"
