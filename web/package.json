{
	"name": "mandalas-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"dependencies": {
		"@etherplay/connect": "^0.1.1",
		"@lucide/svelte": "^1.28.0",
		"abitype": "^1.3.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"form-data": "^4.0.6",
		"mandalas-common": "workspace:*",
		"named-logs": "^0.4.1",
		"tw-animate-css": "^1.4.0",
		"viem": "^2.55.10"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"ipfs-gateway-emulator": "4.2.1-ipfs.2",
		"named-logs-console": "^0.5.1",
		"playwright": "^1.62.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwag": "^0.4.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "~6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-devtools-json": "^1.1.0"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons && svelte-kit sync",
		"generate-pwa-icons": "pwag static/icon.png src/lib/web-config.json",
		"dev": "vite dev",
		"build": "ldenv vite build @@",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8081",
		"pin": "ldenv tsx scripts/pin-to-ipfs.ts",
		"pin:local": "ldenv tsx scripts/pin-to-ipfs.ts --local",
		"test:e2e": "bash ../scripts/run-e2e-tests.sh",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed"
	}
}
